# Repcarparts backend configuration.
# Copy to `.env` for reference, or set these as environment variables in your shell
# (PowerShell: $env:JWT_SECRET = "..."). Real values must never be committed.

# REQUIRED outside dev. >= 32 characters. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-secret

# dev | prod  (default prod). In dev the server may start without JWT_SECRET.
APP_ENV=prod

# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token lifetime in minutes (default 720).
ACCESS_TOKEN_MINUTES=720

# SQLite file and upload folder (defaults: backend/repcarparts.db, backend/uploads).
DATABASE_PATH=backend/repcarparts.db
UPLOAD_DIR=backend/uploads

# Optional one-time admin bootstrap: creates/resets a manager at startup.
# Remove these again after the first start; the password is never logged.
# Prefer:  python -m app.cli set-password <username>
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=choose-a-strong-password

# Frontend (frontend/.env): API base URL, default http://127.0.0.1:8000
#VITE_API_URL=http://127.0.0.1:8000
